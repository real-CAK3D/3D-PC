export default "#define GLSLIFY 1\nuniform float uTime;\nuniform float uTimeFrequency;\nuniform vec2 uUvFrequency;\nuniform vec3 uColor;\nuniform float uAlpha;\nuniform float uSeed;\n// 0 = wisp (thin at the source, fades out on the way up), 1 = haze (soft on every edge)\nuniform float uHaze;\n\nvarying vec2 vUv;\n\nvec2 fade(vec2 t) { return t * t * t * (t * (t * 6.0 - 15.0) + 10.0); }\nvec4 permute(vec4 x) { return mod(((x * 34.0) + 1.0) * x, 289.0); }\n\nfloat perlin2d(vec2 P) {\n  vec4 Pi = floor(P.xyxy) + vec4(0.0, 0.0, 1.0, 1.0);\n  vec4 Pf = fract(P.xyxy) - vec4(0.0, 0.0, 1.0, 1.0);\n  Pi = mod(Pi, 289.0);\n  vec4 ix = Pi.xzxz;\n  vec4 iy = Pi.yyww;\n  vec4 fx = Pf.xzxz;\n  vec4 fy = Pf.yyww;\n  vec4 i = permute(permute(ix) + iy);\n  vec4 gx = 2.0 * fract(i * 0.0243902439) - 1.0;\n  vec4 gy = abs(gx) - 0.5;\n  vec4 tx = floor(gx + 0.5);\n  gx = gx - tx;\n  vec2 g00 = vec2(gx.x, gy.x);\n  vec2 g10 = vec2(gx.y, gy.y);\n  vec2 g01 = vec2(gx.z, gy.z);\n  vec2 g11 = vec2(gx.w, gy.w);\n  vec4 norm =\n      1.79284291400159 - 0.85373472095314 * vec4(dot(g00, g00), dot(g01, g01),\n                                                 dot(g10, g10), dot(g11, g11));\n  g00 *= norm.x;\n  g01 *= norm.y;\n  g10 *= norm.z;\n  g11 *= norm.w;\n  float n00 = dot(g00, vec2(fx.x, fy.x));\n  float n10 = dot(g10, vec2(fx.y, fy.y));\n  float n01 = dot(g01, vec2(fx.z, fy.z));\n  float n11 = dot(g11, vec2(fx.w, fy.w));\n  vec2 fade_xy = fade(Pf.xy);\n  vec2 n_x = mix(vec2(n00, n01), vec2(n10, n11), fade_xy.x);\n  float n_xy = mix(n_x.x, n_x.y, fade_xy.y);\n  return 2.3 * n_xy;\n}\n\nvoid main() {\n  vec2 uv = vUv * uUvFrequency + uSeed;\n  uv.y -= uTime * uTimeFrequency;\n  uv.x += uHaze * uTime * uTimeFrequency * 0.4;\n\n  float n = perlin2d(uv) * 0.65 + perlin2d(uv * 2.3 + 7.0) * 0.35;\n  n = smoothstep(-0.15, 0.9, n);\n\n  float edgeX = min(vUv.x, 1.0 - vUv.x) * 2.0;\n  float alpha;\n  if (uHaze > 0.5) {\n    float edgeY = min(vUv.y, 1.0 - vUv.y) * 2.0;\n    alpha = n * smoothstep(0.0, 1.0, edgeX) * smoothstep(0.0, 1.0, edgeY);\n  } else {\n    // narrow column near the ember that widens and thins out as it rises\n    float width = mix(0.12, 1.0, smoothstep(0.0, 0.6, vUv.y));\n    float column = smoothstep(0.0, width, edgeX);\n    alpha = n * column * (1.0 - vUv.y) * smoothstep(0.0, 0.06, vUv.y);\n  }\n\n  gl_FragColor = vec4(uColor, alpha * uAlpha);\n}\n";